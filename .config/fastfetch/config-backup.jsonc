// fastfetch -h module-format -> show module format options

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        //"source": "~/.config/fastfetch/art/teto.txt", //frieren, machitan, teto
        "type": "small", //"file", 
        "padding": {
            "top": 2,
            "right": 4,
            "left": 2,
            "bottom": 2
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰌢 host    {#keys}│",
            "type": "host",
            "format": "{name}"
        },
        {
            "key": "│ {#33}{icon} distro  {#keys}│",
            "type": "os",
            "format": "{name}"
        },
        {
            "key": "│ {#34} kernel  {#keys}│",
            "type": "kernel",
            "format": "{release}"
        },
        {
            "key": "│ {#35}󰇄 wm      {#keys}│",
            "type": "wm",
            "format": "{process-name}"
        },
        {
            "key": "│ {#36} term    {#keys}│",
            "type": "terminal",
            "format": "{process-name}"
        },
        {
            "key": "│ {#31} shell   {#keys}│",
            "type": "shell",
            "format": "{process-name}"
        },
        {
            "key": "│ {#32}󰏖 pkgs    {#keys}│",
            "type": "packages" 
        },
        {
            "key": "│ {#33}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {#34}󰅐 os age  {#keys}│",
            "type": "command",
            "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days\""

        },
        {
            "key": "│ {#35}󰉉 disk    {#keys}│",
            "format": "{size-used} / {size-total}",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#36} memory  {#keys}│",
            "type": "memory",
            "format": "{used} / {total}"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}