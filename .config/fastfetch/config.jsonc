{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/assets/patchouli-fumo.png",
    "width": 22,
    "height": 11,
    "preserveAspectRatio": true,
    "padding": {
      "top": 4,
      "right": 3,
      "left": 1
    },
    "color": {
      "1": "#f563e7",
      "2": "#fab363"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    },
    "color": {
      "keys": "#f5c2e7",
      "title": "#f5c2e7"
    },
    "percent": {
      "color": {
        "green": "#94e2d5",
        "yellow": "#ed91d4",
        "red": "#f38ba8"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    "break",
    {
      "type": "os",
      "key": "󰌢  OS",
      "format": "{name} {version-id}"
    },
    {
      "type": "command",
      "key": "  Kernel",
      "text": "uname -r | cut -d- -f1"
    },
    {
      "type": "packages",
      "key": "󰏖  Pkgs",
      "format": "{rpm} rpm / {flatpak-all} flatpak"
    },
    "break",
    {
      "type": "wm",
      "key": "  WM",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "  Shell",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "  Term",
      "format": "{pretty-name}"
    },
    "break",
    {
      "type": "uptime",
      "key": "󰥔  Uptime",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    {
      "type": "command",
      "key": "󰅐  OS age",
      "text": "echo \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))d\""
    },
    {
      "type": "memory",
      "key": "  RAM",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
