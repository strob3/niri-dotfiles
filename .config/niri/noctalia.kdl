layout {

    focus-ring {
        active-color   "#9da6b6"
        inactive-color "#1c1e21"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#9da6b6"
        inactive-color "#1c1e21"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#9da6b6"
        inactive-color "#444d5c"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#9da6b680"
    }
}

recent-windows {
    highlight {
        active-color "#9da6b6"
        urgent-color "#fd4663"
    }
}
